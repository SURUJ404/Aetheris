APP_ENV=development
RUST_LOG=info
BIND_ADDR=127.0.0.1:8081
TASK_GRPC_BIND_ADDR=127.0.0.1:50052

# Identity provider (provider-agnostic; see migration/adr/0001-identity-provider.md)
# Values must be the issuer/JWKS as seen by the process running the control
# plane. 127.0.0.1 is correct only when that process runs on the host; inside
# the rust.ps1 container, 127.0.0.1 is the container itself.
OIDC_ISSUER=http://127.0.0.1:8080/realms/agentic-platform
OIDC_AUDIENCE=rust-control-plane
OIDC_JWKS_URI=http://127.0.0.1:8080/realms/agentic-platform/protocol/openid-connect/certs
OIDC_TENANT_CLAIM=tenant_id

# Set POSTGRES_PASSWORD to a local throwaway value before starting compose.
POSTGRES_PASSWORD=replace-with-local-dev-password
DATABASE_URL=postgresql://agentic:replace-with-local-dev-password@localhost:55432/agentic
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIGRATE=true
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
NATS_URL=nats://localhost:4222
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=rust-control-plane
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=

# Sandbox execution (Step 3). Rust is the execution authority: these values are
# operator ceilings, never client-controlled. A request may ask for less, never
# more. See ARCHITECTURE.md.
#
# Comma-separated allowlist. A runtime absent here cannot be requested even if
# its host support exists. Firecracker additionally requires /dev/kvm and the
# images below; without them it reports unavailable and refuses to execute.
EXECUTION_RUNTIMES=wasmtime

# Approved workload registry: manifest.json plus hash-pinned modules. Arbitrary
# module upload is not supported.
EXECUTION_WORKLOAD_DIR=workloads

# Parent for per-execution scratch directories. Empty falls back to a
# directory under the system temp dir. Use an absolute path in production; the
# process working directory is not a security boundary.
EXECUTION_SCRATCH_ROOT=

EXECUTION_MAX_CONCURRENT_PER_TENANT=4
EXECUTION_MAX_WALL_CLOCK_MS=30000
EXECUTION_MAX_CPU_FUEL=1000000000
EXECUTION_MAX_MEMORY_BYTES=268435456
EXECUTION_MAX_OUTPUT_BYTES=1048576
EXECUTION_MAX_STDIN_BYTES=1048576
EXECUTION_MAX_ARTIFACTS_BYTES=8388608

# Wasmtime: one read/write scratch directory at /scratch, no network, no
# inherited environment. Set to false to expose no filesystem at all.
EXECUTION_WASMTIME_SCRATCH=true
EXECUTION_WASMTIME_MAX_STACK_BYTES=524288

# Firecracker: only used when listed in EXECUTION_RUNTIMES. The rootfs must
# contain the guest agent at /usr/local/bin/agent on vsock port 52.
FIRECRACKER_BINARY=/usr/local/bin/firecracker
FIRECRACKER_KERNEL_IMAGE=/var/lib/agentic/vmlinux.bin
FIRECRACKER_ROOTFS_IMAGE=/var/lib/agentic/rootfs.ext4
FIRECRACKER_VCPU_COUNT=1
FIRECRACKER_MEMORY_MIB=512
# Empty falls back to a directory under the system temp dir.
FIRECRACKER_SCRATCH_ROOT=

# Local Keycloak bootstrap / smoke-test inputs. These are intentionally empty:
# generate throwaway values for local use and keep them out of version control.
KC_ADMIN_PASSWORD=
KC_CLIENT_SECRET=
KC_DEV_USERNAME=dev-user
KC_DEV_PASSWORD=

# Never commit real credentials. Use a secret manager in production.
